Options -Indexes

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^(\.superpowers|docs|workflow|tools|test-results|Audit%20Seo%20Gratuit%20-%20Design)(/|$) - [F,L]
  RewriteRule ^(router\.local\.php|plan-refactor-audit-seo-gratuit\.md|error_log|php-server\.(err\.)?log|\.gitignore)$ - [F,L]
  RewriteRule ^app/public/assets/ - [L]
  RewriteRule ^app/ - [F,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [L]
</IfModule>
