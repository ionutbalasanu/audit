APP_ORIGIN=https://novaweb.ro
APP_BASE=/tools/audit-seo-gratuit
APP_URL=https://novaweb.ro/tools/audit-seo-gratuit
APP_ENV=production

STORAGE_DIR=/absolute/path/outside/webroot/audit-seo-storage
MAX_JSON_BODY_BYTES=65536

ENABLE_CF_RENDER=0
CF_ACCOUNT_ID=
CF_API_TOKEN=
HTTP_MAX_BYTES=5242880
CACHE_TTL=900

RATE_LIMIT_SCORE=200
RATE_LIMIT_EMAIL=3
RATE_LIMIT_LEAD=3
RATE_LIMIT_RETENTION_DAYS=2
REPORT_RETENTION_DAYS=30
LEAD_RETENTION_DAYS=180
LOG_RETENTION_DAYS=14
SITE_AUDIT_RUN_LIMIT=3
SITE_AUDIT_WINDOW_SECONDS=86400

REPORT_ACCESS_KEY=change-me-generate-64-hex-chars
SITE_AUDIT_ACCESS_KEY=change-me-generate-64-hex-chars

SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=noreply@example.com
SMTP_PASS=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=NovaWeb Audit SEO
MAIL_REPLY_TO=contact@example.com
MAIL_REPLY_TO_NAME=NovaWeb
LEAD_NOTIFY_EMAIL=contact@example.com

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

WP_SUBSCRIBE_URL=
WP_SUBSCRIBE_TOKEN=
WP_AUDIT_LIST_NAME=Audit SEO Gratuit - Sfaturi de remediere
WP_LEADS_LIST_NAME=Audit SEO Gratuit - Sfaturi de remediere
WP_LIST_NAME=Audit SEO Gratuit - Sfaturi de remediere
WP_PLAN_LIST_NAME=Audit SEO Gratuit - Sfaturi de remediere
WP_INSECURE=0

TRUST_CF_CONNECTING_IP=0
