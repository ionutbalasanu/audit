Options -Indexes

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

RewriteEngine On

RewriteRule ^(storage|src|vendor)(/|$) - [F,L]
RewriteRule ^\.env - [F,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^ index.php [L]
